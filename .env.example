# 复制为 .env 后填写真实密钥；不要提交 .env。
DEEPSEEK_API_KEY=

# 联网主搜索。留空时，项目会尝试使用 ddgs 作为备用搜索。
ANYSEARCH_API_KEY=

# 合规复核 Agent 的判卷模型（默认智谱 GLM，OpenAI 兼容接口）。
# 留空时复核调用会失败，但复核层 fail-open，不影响主流程。
GLM_API_KEY=

# 可选：复核开关（默认开启；设为 0/false/no 可关闭）
# REVIEW_AGENT_ENABLED=1

# ── Redis 缓存（意图识别 1.1 + 客观知识回答 1.1B + 检索结果 #3）──
# 连接地址（默认 localhost:6379，Docker redis 容器映射端口）
# REDIS_URL=redis://localhost:6379/0
# 意图缓存 TTL（秒，默认 24 小时）
# INTENT_CACHE_TTL=86400
# 回答缓存 TTL（秒，默认 24 小时）
# ANSWER_CACHE_TTL=86400
# 检索结果缓存 TTL（秒，默认 7 天；真正失效靠 config.VECTORSTORE_VERSION）
# RETRIEVAL_CACHE_TTL=604800
# 总开关（默认开启；无 Redis 环境设 0 关闭，例如 CI/离线测试）
# CACHE_ENABLED=1
