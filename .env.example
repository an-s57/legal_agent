# 复制为 .env 后填写真实密钥；不要提交 .env。
DEEPSEEK_API_KEY=

# 联网主搜索。留空时，项目会尝试使用 ddgs 作为备用搜索。
ANYSEARCH_API_KEY=

# 合规复核 Agent 的判卷模型（默认智谱 GLM，OpenAI 兼容接口）。
# 留空时复核调用会失败，但复核层 fail-open，不影响主流程。
GLM_API_KEY=

# 可选：复核开关（默认开启；设为 0/false/no 可关闭）
# REVIEW_AGENT_ENABLED=1

# ── Redis 缓存（意图识别 1.1 + 客观知识回答 1.1B + 检索结果 #3）──
# 本机运行时可显式填写 localhost；Docker Compose 会自动覆盖为 redis 服务名。
# REDIS_URL=redis://localhost:6379/0
# 意图缓存 TTL（秒，默认 24 小时）
# INTENT_CACHE_TTL=86400
# 回答缓存 TTL（秒，默认 24 小时）
# ANSWER_CACHE_TTL=86400
# 检索结果缓存 TTL（秒，默认 7 天；真正失效靠 config.VECTORSTORE_VERSION）
# RETRIEVAL_CACHE_TTL=604800
# 总开关（默认开启；无 Redis 环境设 0 关闭，例如 CI/离线测试）
# CACHE_ENABLED=1

# ── 运营数据问答（ops_data_qa/，text-to-SQL）──
# MySQL 连接（务必用只读账号：仅授 ops_demo 库的 SELECT 权限）
# OPS_DB_HOST=127.0.0.1
# OPS_DB_PORT=3306
# OPS_DB_USER=query_user
# OPS_DB_PASSWORD=
# OPS_DB_NAME=ops_demo
# 后台接口 /ops/qa 的鉴权令牌：请求头 X-OPS-TOKEN 必须带它（不配置则接口停用）
# OPS_QA_TOKEN=
# LLM 意图门（用 GLM 判"想不想改数据"；缺 GLM_API_KEY 时自动跳过该层）。
# A/B 对比评测时可设 0 只跑词面规则。
# OPS_INTENT_LLM_ENABLED=1
# 造索引实验数据用（mysql_lab/make_big_table.py）：写权限账号，仅本地实验使用
# OPS_DB_ADMIN_USER=root
# OPS_DB_ADMIN_PASSWORD=
